rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common ID Validator
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Helper functions for entity validation
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.stockQuantity is number && data.stockQuantity >= 0;
    }

    function isValidInventoryLot(data) {
      return (('productName' in data && data.productName is string && data.productName.size() > 0) ||
              ('spiritName' in data && data.spiritName is string && data.spiritName.size() > 0)) &&
             (('caskLotNumber' in data && data.caskLotNumber is string) ||
              ('caskNumber' in data && data.caskNumber is string)) &&
             (('bottlesInStock' in data && data.bottlesInStock is number && data.bottlesInStock >= 0) ||
              ('volumeLiters' in data && data.volumeLiters is number && data.volumeLiters >= 0));
    }

    function isValidOrder(data) {
      return (('orderNumber' in data && data.orderNumber is string && data.orderNumber.size() > 0) ||
              ('id' in data && data.id is string && data.id.size() > 0)) &&
             data.total is number && data.total >= 0 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100;
    }

    function isValidBlogPost(data) {
      return data.title is string && data.title.size() > 0 &&
             data.content is string && data.content.size() > 0;
    }

    function isValidSiteContent(data) {
      return data.keys().size() > 0;
    }

    function isValidCustomer(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('loyaltyPoints' in data) || (data.loyaltyPoints is number && data.loyaltyPoints >= 0)) &&
             (!('totalSpent' in data) || (data.totalSpent is number && data.totalSpent >= 0)) &&
             (!('spiritPreferences' in data) || (data.spiritPreferences is list && data.spiritPreferences.size() <= 25));
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() > 0 && data.productId.size() <= 64 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 120 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 5000 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5;
    }

    function isValidBallotAllocation(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             (('totalBottlesAvailable' in data && data.totalBottlesAvailable is number && data.totalBottlesAvailable > 0) ||
              ('bottleYieldTotal' in data && data.bottleYieldTotal is number && data.bottleYieldTotal > 0)) &&
             (('bottlePrice' in data && data.bottlePrice is number && data.bottlePrice >= 0) ||
              ('pricePerBottle' in data && data.pricePerBottle is number && data.pricePerBottle >= 0)) &&
             data.status is string;
    }

    function isValidBallotEntry(data) {
      return data.allocationId is string && data.allocationId.size() > 0 &&
             (('customerName' in data && data.customerName is string && data.customerName.size() > 0) ||
              ('userName' in data && data.userName is string && data.userName.size() > 0)) &&
             (('customerEmail' in data && data.customerEmail is string && data.customerEmail.size() > 0) ||
              ('userEmail' in data && data.userEmail is string && data.userEmail.size() > 0)) &&
             data.bottlesRequested is number && data.bottlesRequested >= 1 && data.bottlesRequested <= 10 &&
             data.status is string;
    }

    function isValidLetterhead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 250 &&
             data.distilleryName is string && data.distilleryName.size() > 0 &&
             data.paperStyle is string && data.headerLayout is string;
    }

    function isValidLetterheadDocument(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.templateId is string && data.templateId.size() > 0 &&
             data.recipientName is string && data.recipientName.size() > 0 &&
             data.status is string;
    }

    // 1. Products Catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }

    // 2. Distiller Inventory Lots
    match /inventory/{lotId} {
      allow read: if true;
      allow create, update: if isValidId(lotId) && isValidInventoryLot(request.resource.data);
      allow delete: if isValidId(lotId);
    }

    // 3. Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // 4. Blog Articles & Notes
    match /blog_posts/{postId} {
      allow read: if true;
      allow create, update: if isValidId(postId) && isValidBlogPost(request.resource.data);
      allow delete: if isValidId(postId);
    }

    // 5. Site CMS Content
    match /site_content/{contentId} {
      allow read: if true;
      allow create, update: if isValidId(contentId) && isValidSiteContent(request.resource.data);
      allow delete: if isValidId(contentId);
    }

    // 6. Customer Accounts
    match /customers/{customerId} {
      allow read: if isValidId(customerId);
      allow create: if isValidId(customerId) && isValidCustomer(request.resource.data) &&
                      (!('id' in request.resource.data) || request.resource.data.id == customerId);
      allow update: if isValidId(customerId) && isValidCustomer(request.resource.data);
      allow delete: if isValidId(customerId);
    }

    // 7. Product Reviews & Connoisseur Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow update: if isValidId(reviewId) && (
        isValidReview(request.resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'helpfulVoters', 'updatedAt'])
      );
      allow delete: if isValidId(reviewId);
    }

    // 8. Limited Edition Ballot Allocations
    match /ballot_allocations/{allocationId} {
      allow read: if true;
      allow create, update: if isValidId(allocationId) && isValidBallotAllocation(request.resource.data);
      allow delete: if isValidId(allocationId);
    }

    // 9. Collector Ballot Entries
    match /ballot_entries/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId) && isValidBallotEntry(request.resource.data);
      allow delete: if isValidId(entryId);
    }

    // 10. Letterhead Templates
    match /letterheads/{letterheadId} {
      allow read: if true;
      allow create, update: if isValidId(letterheadId) && isValidLetterhead(request.resource.data);
      allow delete: if isValidId(letterheadId);
    }

    // 11. Letterhead Documents & Certificates
    match /letterhead_documents/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && isValidLetterheadDocument(request.resource.data);
      allow delete: if isValidId(docId);
    }
  }
}
